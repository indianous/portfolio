# URL pública do site, usada em canonical, Open Graph, sitemap e robots.
# Na Vercel, sem esta variável, usa-se VERCEL_PROJECT_PRODUCTION_URL; localmente, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Links do rodapé (coluna "Redes"). Sem valor, o link não aparece.
LINKEDIN_URL=
CONTACT_EMAIL=

# API do GitHub (seção "No GitHub" na home e em /about). Só no servidor: nunca use NEXT_PUBLIC_.
# Token fine-grained, só leitura de dados públicos. Sem ele, a seção não aparece.
# Localmente: export GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=
# Usuário do GitHub. Sem valor, usa o do link do GitHub em src/config/site.ts.
GITHUB_USERNAME=
